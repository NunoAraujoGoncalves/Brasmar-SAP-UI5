{
  "_version": "1.60.0",
  "sap.app": {
    "id": "brasmar.bm01.controloqualidade4",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.19.3",
      "toolsId": "33b92691-8992-4ec0-afda-a2d67e456b57"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_tabcq_o4/srvd/sap/zui_tabcq_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.macros": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "brasmar.bm01.controloqualidade4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "ui": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "models/ui.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "Icon/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "CQCabMain",
          "pattern": ":?query:",
          "target": "CQCabMain"
        },
        {
          "name": "CQCabCQDetailPage",
          "pattern": "CQCab({CQCabKey}):?query:",
          "target": "CQCabCQDetailPage"
        },
        {
          "name": "CQLinhasCQLinhaDetailPage",
          "pattern": "CQCab({CQCabKey})/_linhas({_linhasKey}):?query:",
          "target": "CQLinhasCQLinhaDetailPage"
        }
      ],
      "targets": {
        "CQCabMain": {
          "type": "Component",
          "id": "CQCabMain",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {
                "CQCab": {
                  "detail": {
                    "route": "CQCabCQDetailPage"
                  }
                }
              },
              "contextPath": "/CQCab",
              "viewName": "brasmar.bm01.controloqualidade4.ext.main.Main"
            }
          }
        },
        "CQCabCQDetailPage": {
          "type": "Component",
          "id": "CQCabCQDetailPage",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {
                "_linhas": {
                  "detail": {
                    "route": "CQLinhasCQLinhaDetailPage"
                  }
                }
              },
              "contextPath": "/CQCab",
              "viewName": "brasmar.bm01.controloqualidade4.ext.view.CQDetail"
            }
          }
        },
        "CQLinhasCQLinhaDetailPage": {
          "type": "Component",
          "id": "CQLinhasCQLinhaDetailPage",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/CQCab/_linhas",
              "viewName": "brasmar.bm01.controloqualidade4.ext.view.CQLinhaDetail"
            }
          }
        }
      }
    }
  }
}
