<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Dialog id="descodificaCBDialog" title="{i18n>cbcaixa.title}" binding="{com.sap.gateway.srvd.zui_tabcq_o4.v0001.descodificaCBCaixa(...)}" contentWidth="450px">

        <form:SimpleForm id="descodificaCBForm" binding="{$Parameter}" editable="true" columnsXL="1" columnsL="1">
            <Label id="descodificaCBLabel" text="{i18n>cbcaixa.cb.label}" />
            <Input id="descodificaCBInput" value="{CodigoBarras}" />
            <!-- <Label id="empty" text="" /> -->
            <Button id="descodifica" text="{i18n>cbcaixa.btn.descodificar}" press=".onPressDescodifica" />
        </form:SimpleForm>
        <List id="descodificaCBList" items="{value}" busyIndicatorDelay="10">
            <items>
                <ObjectListItem id="descodificaCBListItem" title="{Material}" number="{Qtd}" numberUnit="{Uom}" intro="{MaterialDesc}">
                    <attributes>
                        <ObjectAttribute id="cxGtin" title="{i18n>cbcaixa.list.gtin}" text="{Gtin}" />
                        <ObjectAttribute id="cxLote" title="{i18n>cbcaixa.list.lote}" text="{Lote}" />
                        <ObjectAttribute id="cxValidade" title="{i18n>cbcaixa.list.validade}" text="{Validade}" />
                        <ObjectAttribute id="cxNEmbalCaixa" title="{i18n>cbcaixa.list.nunidades}" text="{NEmbalCaixa}" />
                    </attributes>
                </ObjectListItem>
            </items>
        </List>
        <endButton>
            <Button id="descodificaCBClose" text="{i18n>cbcaixa.btn.close}" press=".onPressCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>