<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards">
    <!-- core:require="{ Formatter: 'brasmar/bm01/controloqualidade4/ext/modules/Formatter'}" -->
    <Popover id="idtag_popover" placement="Right" showHeader="false" contentWidth="990px">
        <!-- <f:Card id="idtag_card" width="100%">
            <f:header>
 
            </f:header>
            <f:content> -->
        <FlexBox id="idtag_card_flexBox" wrap="Wrap" alignContent="Start" alignItems="Start" width="100%">
            <VBox id="idtag_card_vertical_controlo" displayInline="true" class='sapUiTinyMargin'>
                <Title id="idtag_card_vertical_controlo_title" level="H3" class="sapUiTinyMarginBottom" text="{i18n>cqDetail.header.controlo}"></Title>
                <HBox id="idtag_card_hbox0" renderType="Bare" class="sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_centro" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.centro}"></Label>
                    <Text id="idtag_card_text_centro" emptyIndicatorMode="On" renderWhitespace="true" text="{Centro}"></Text>
                </HBox>
                <HBox id="idtag_card_hbox1" renderType="Bare" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_id" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.id}"></Label>
                    <Text id="idtag_card_text_id" emptyIndicatorMode="On" renderWhitespace="true" text="{ID}"></Text>
                </HBox>
                <HBox id="idtag_card_hbox2" renderType="Bare" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_status" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.status}"></Label>
                    <Text id="idtag_card_text_status" emptyIndicatorMode="On" renderWhitespace="true" text="{parts:[ 'Estado', 'EstadoDesc' ], formatter:'.formatter.detailFieldFormatter'}"></Text>
                </HBox>
            </VBox>

            <VBox id="idtag_card_vertical_produto" displayInline="true" class='sapUiTinyMargin'>
                <Title id="idtag_card_vertical_produto_title" level="H3" class="sapUiTinyMarginBottom" text="{i18n>cqDetail.header.produto}"></Title>
                <HBox id="idtag_card_hbox3" renderType="Bare" class="sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_material" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.material}"></Label>
                    <Text id="idtag_card_text_material" emptyIndicatorMode="On" renderWhitespace="true" text="{Material}"></Text>
                </HBox>
                <HBox id="idtag_card_hbox4" renderType="Bare" class="sapUiTinyMarginBottom">
                    <!-- <Label id="idtag_card_label_desc" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.matDesc}"></Label> -->
                    <Text id="idtag_card_text_desc" emptyIndicatorMode="On" renderWhitespace="true" text="{MaterialDesc}"></Text>
                </HBox>
                <HBox id="idtag_card_hbox5" renderType="Bare" class="sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_lote" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.lote}"></Label>
                    <Text id="idtag_card_text_lote" emptyIndicatorMode="On" renderWhitespace="true" text="{Lote}"></Text>
                </HBox>
            </VBox>


            <VBox id="idtag_card_vertical_detalhe" displayInline="true" class='sapUiTinyMargin'>
                <Title id="idtag_card_vertical_detalhe_title" level="H3" class="sapUiTinyMarginBottom" text="{i18n>cqDetail.header.detalhe}"></Title>
                <HBox id="idtag_card_hbox6" renderType="Bare" class="sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_tipoDoc" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.tipoDoc}"></Label>
                    <Text id="idtag_card_text_tipoDoc" emptyIndicatorMode="On" renderWhitespace="true" text="{parts:[ 'Tipodoc', 'TipodocDesc' ], formatter:'.formatter.detailFieldFormatter'}"></Text>
                </HBox>
                <HBox id="idtag_card_hbox7" renderType="Bare" class="sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_document" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.documento}"></Label>
                    <Text id="idtag_card_text_document" emptyIndicatorMode="On" renderWhitespace="true" text="{Documento}"></Text>
                </HBox>
                <HBox id="idtag_card_hbox8" renderType="Bare" class="sapUiTinyMarginBottom">
                    <Label id="idtag_card_label_tipoProd" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.tipoProd}"></Label>
                    <Text id="idtag_card_text_tipoProd" emptyIndicatorMode="On" renderWhitespace="true" text="{parts:[ 'Tipoprod', 'TipoprodDesc' ], formatter:'.formatter.detailFieldFormatter'}"></Text>
                </HBox>
            </VBox>
        </FlexBox>
        <!-- </f:content>
        </f:Card> -->
    </Popover>
</core:FragmentDefinition>