<mvc:View xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:macros="sap.fe.macros"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:l="sap.ui.layout.form" controllerName="brasmar.bm01.controloqualidade4.ext.view.CQDetail">
    <f:DynamicPage id="CQDetail_dynamicPage" stickySubheaderProvider="iconTabBar" toggleHeaderOnTitleClick="true">
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle id="CQDetail_dynamicPage_title">
                <f:heading>
                    <Title id="CQDetail_dynamicPage_titleText" text="{i18n>cqDetail.title}" />
                </f:heading>
                <f:content>
                    <OverflowToolbar id="CQDetail_dynamicPage_title_overflowToolbar">
                        <GenericTag id="CQDetail_dynamicPage_title_genericTag" text="{path: 'ID', formatter: '.formatter.detailHeaderFormatter'}" status="Information" press="onGenericTagPress" design="StatusIconHidden" />
                    </OverflowToolbar>
                </f:content>
                <f:actions>
                    <Button id="CQDetail_dynamicPage_Edit" text="{i18n>cqDetail.btn.edit}" type="Emphasized" />
                    <Button id="CQDetail_dynamicPage_Delete" text="{i18n>cqDetail.btn.delete}" type="Transparent" />
                    <Button id="CQDetail_dynamicPage_Print" text="{i18n>cqDetail.btn.print}" type="Transparent" />
                    <Button id="CQDetail_dynamicPage_Copy" text="{i18n>cqDetail.btn.copy}" type="Transparent" />
                    <Button id="CQDetail_dynamicPage_ModifyMaterial" text="{i18n>cqDetail.btn.modifyMaterial}" type="Transparent" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- DynamicPage Header -->
        <f:header>
            <f:DynamicPageHeader id="CQDetail_dynamicPageHeader" pinnable="true">
                <FlexBox id="CQDetail_dynamicPageHeader_flexBox" wrap="Wrap" alignContent="Start" alignItems="Start" width="100%">
                    <VBox id="CQDetail_dynamicPageHeader_vertical_controlo" displayInline="true" class='sapUiSmallMargin'>
                        <Title id="CQDetail_dynamicPageHeader_vertical_controlo_title" level="H3" class="sapUiTinyMarginBottom" text="{i18n>cqDetail.header.controlo}"></Title>
                        <HBox id="_hbox0" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_centro" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.centro}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_centro" emptyIndicatorMode="On" renderWhitespace="true" text="{Centro}"></Text>
                        </HBox>
                        <HBox id="_hbox1" renderType="Bare" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_id" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.id}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_id" emptyIndicatorMode="On" renderWhitespace="true" text="{ID}"></Text>
                        </HBox>
                        <HBox id="_hbox2" renderType="Bare" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_status" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.status}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_status" emptyIndicatorMode="On" renderWhitespace="true" text="{parts:[ 'Estado', 'EstadoDesc' ], formatter:'.formatter.detailFieldFormatter'}"></Text>
                        </HBox>
                    </VBox>

                    <VBox id="CQDetail_dynamicPageHeader_vertical_produto" displayInline="true" class='sapUiSmallMargin'>
                        <Title id="CQDetail_dynamicPageHeader_vertical_produto_title" level="H3" class="sapUiTinyMarginBottom" text="{i18n>cqDetail.header.produto}"></Title>
                        <HBox id="_hbox3" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_material" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.material}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_material" emptyIndicatorMode="On" renderWhitespace="true" text="{Material}"></Text>
                        </HBox>
                        <HBox id="_hbox4" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_desc" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.matDesc}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_desc" emptyIndicatorMode="On" renderWhitespace="true" text="{MaterialDesc}"></Text>
                        </HBox>
                        <HBox id="_hbox5" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_lote" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.lote}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_lote" emptyIndicatorMode="On" renderWhitespace="true" text="{Lote}"></Text>
                        </HBox>
                    </VBox>


                    <VBox id="CQDetail_dynamicPageHeader_vertical_detalhe" displayInline="true" class='sapUiSmallMargin'>
                        <Title id="CQDetail_dynamicPageHeader_vertical_detalhe_title" level="H3" class="sapUiTinyMarginBottom" text="{i18n>cqDetail.header.detalhe}"></Title>
                        <HBox id="_hbox6" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_tipoDoc" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.tipoDoc}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_tipoDoc" emptyIndicatorMode="On" renderWhitespace="true" text="{parts:[ 'Tipodoc', 'TipodocDesc' ], formatter:'.formatter.detailFieldFormatter'}"></Text>
                        </HBox>
                        <HBox id="_hbox7" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_document" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.documento}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_document" emptyIndicatorMode="On" renderWhitespace="true" text="{Documento}"></Text>
                        </HBox>
                        <HBox id="_hbox8" renderType="Bare" class="sapUiTinyMarginBottom">
                            <Label id="CQDetail_dynamicPageHeader_label_tipoProd" wrapping="true" class="sapUiTinyMarginEnd" text="{i18n>cqDetail.header.tipoProd}"></Label>
                            <Text id="CQDetail_dynamicPageHeader_text_tipoProd" emptyIndicatorMode="On" renderWhitespace="true" text="{parts:[ 'Tipoprod', 'TipoprodDesc' ], formatter:'.formatter.detailFieldFormatter'}"></Text>
                        </HBox>
                    </VBox>
                </FlexBox>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Conteudo -->
        <f:content>
            <IconTabBar id="CQDetail_sections_tabbar" class="sapUiResponsiveContentPadding">
            <items>
            <IconTabFilter id="tt"></IconTabFilter>
            
            </items>
            </IconTabBar>
        </f:content>
    </f:DynamicPage>
</mvc:View>
