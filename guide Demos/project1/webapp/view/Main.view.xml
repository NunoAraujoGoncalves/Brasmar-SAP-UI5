<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
>
    <uxap:ObjectPageLayout
        id="objPage"
        showTitleInHeaderContent="true"
        showFooter="true"
        upperCaseAnchorBar="false"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="objPageHeaderTitle">
                <uxap:breadcrumbs>
                    <Breadcrumbs
                        id="breadcrumbs"
                        currentLocationText="New Book"
                    >
                        <Link
                            id="link1"
                            text="Books"
                        />
                    </Breadcrumbs>
                </uxap:breadcrumbs>
                <uxap:expandedHeading>
                    <Title
                        id="expandedHeading"
                        text="Your new Book"
                        wrapping="true"
                    />
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title
                        id="snappedHeading"
                        text="Your snapped Book"
                        wrapping="true"
                    />
                </uxap:snappedHeading>
                <uxap:expandedContent>
                    <Text
                        id="expandedContent"
                        text="Add a Book"
                    />
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <Text
                        id="snappedContent"
                        text="Add a snapped Book"
                    />
                </uxap:snappedContent>
                <uxap:snappedTitleOnMobile>
                    <Title
                        id="snappedMobileTitle"
                        text="Add a Book"
                    />
                </uxap:snappedTitleOnMobile>
                <uxap:actions>
                    <Button
                        id="btnSearch"
                        text="Search on Rheinwerk"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <FlexBox
                id="flexBox"
                wrap="Wrap"
            >
                <Avatar
                    id="avatar"
                    class="sapUiSmallMargin"
                    src="sap-icon://add-coursebook"
                    displaySize="L"
                />
            </FlexBox>
        </uxap:headerContent>

        <uxap:sections>
            <uxap:ObjectPageSection
                id="objPageSection"
                titleUppercase="false"
                title="I'm a section"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        id="objPS_SubSection"
                        title="I'm a subsection"
                    >
                        <uxap:blocks>
                            <Text
                                id="objPSSS_text"
                                text="I'm a text"
                            />
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                    <uxap:ObjectPageSubSection
                        id="objPS_SubSection2"
                        title="I'm a subsectiontoo"
                    >
                        <uxap:blocks>
                            <Text
                                id="objPSSS_text2"
                                text="I'm a text too"
                            />
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                id="objPageSection2"
                titleUppercase="false"
                title="I'm a second section"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        id="objPS_SubSection3"
                        title="I'm a subsection"
                    >
                        <uxap:blocks>
                            <Text
                                id="objPSSS_text3"
                                text="I'm a text"
                            />
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                    <uxap:ObjectPageSubSection
                        id="objPS_SubSection4"
                        title="I'm a subsection too"
                    >
                        <uxap:blocks>
                            <Text
                                id="objPSSS_text4"
                                text="I'm a text too"
                            />
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

        <uxap:footer>
            <OverflowToolbar id="footerOverflowToolbar">
                <ToolbarSpacer id="footerOTToolbarSpacer"/>
                <Button id="btnSave"
                    text="Save"
                    type="Accept"
                />
                <Button id="btnCancel"
                    text="Cancel"
                    type="Reject"
                />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
