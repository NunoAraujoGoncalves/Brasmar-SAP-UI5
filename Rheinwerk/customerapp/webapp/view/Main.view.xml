<mvc:View
    controllerName="com.sappress.customerapp.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        id="page"
        title="My first page"
    >
        <content>
            <f:SimpleForm
                id="SimpleFormChange354"
                editable="true"
                layout="ResponsiveGridLayout"
                title="Customer Details"
                labelSpanXL="2"
                labelSpanL="2"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="5"
                emptySpanL="5"
                emptySpanM="2"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            >
                <f:content>
                    <Label text="Customer ID" />
                    <Input value="" />

                    <Label text="FirstName" />
                    <Input id="inpFirstname" value="" />

                    <Label text="LastName" />
                    <Input value="" />

                    <Label text="Title" />
                    <Input value="" />

                    <Label text="Gender" />
                    <Select>
                        <core:Item
                            key=""
                            text="Female"
                        />
                        <core:Item
                            key=""
                            text="Male"
                        />
                        <core:Item
                            key=""
                            text="Other"
                        />
                    </Select>

                    <Label text="Birthday" />
                    <DatePicker />

                    <Label text="E-Mail" />
                    <Input value="" />

                    <Label text="Phone" />
                    <Input value="" />

                    <Label text="Website" />
                    <Input value="" />
                </f:content>
            </f:SimpleForm>

            <Button text="Press me!" press="onButtonPressed"/>

            <!-- <Button type="Accept" icon="sap-icon://" text="Press me!" /> -->
            <!-- <VBox> 
                <Text text="My Text is displayed here!" />
                <Text text="My Text is displayed here!" />
                <Text text="My Text is displayed here!" />
                <Text text="My Text is displayed here!" />
                <Text text="My Text is displayed here!" />
            </VBox>
            -->
        </content>
    </Page>
</mvc:View>
