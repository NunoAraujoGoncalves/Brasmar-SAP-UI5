{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.sappress.customerapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.4",
      "toolsId": "9c6ef845-fca3-4895-8502-5f06fd19f2ab"
    },
    "dataSources": {
      "C_CUSTOMER_OP_ANNO_MDL": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='C_CUSTOMER_OP_ANNO_MDL',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/C_CUSTOMER_OP_ANNO_MDL.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/C_CUSTOMER_OP_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [
            "C_CUSTOMER_OP_ANNO_MDL"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sappress.customerapp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "genderModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/genders.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.sappress.customerapp.view",
        "async": true,
        "viewPath": "com.sappress.customerapp.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetOverview"
          ]
        },
        {
          "name": "RouteDetail",
          "pattern": "/customer/{customerId}",
          "target": [
            "TargetDetail"
          ]
        }
      ],
      "targets": {
        "TargetDetail": {
          "id": "Customer",
          "name": "Customer"
        },
        "TargetOverview": {
          "id": "Overview",
          "name": "Overview"
        }
      }
    },
    "rootView": {
      "viewName": "com.sappress.customerapp.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
