<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
<Dialog
        id="descodificaUnidadeDialog"
        title="{i18n>descodificacbun}"
        binding="{com.sap.gateway.srvd.zui_tabcq_o4.v0001.descodificaCBUn(...)}"
        contentWidth="400px"
    >
        <form:SimpleForm
            id="descodificaUnidadeForm"
            binding="{$Parameter}"
            editable="true"
            labelSpanS="4"
        >
            <Label
                id="descodificaUnidadeLabel"
                text="Código Barras"
            />
            <Input
                id="descodificaUnidadeInput"
                value="{CodigoBarras}"
            />
            <Label
                id="emptyUnidade"
                text=""
            />
            <Button
                id="descodificaUnidade"
                text="{i18n>descodificacbun}"
                press=".onPressDescodificaUN"
            />
        </form:SimpleForm>
        <List
            id="descodificaUnidadeList"
            items="{value}"
            busyIndicatorDelay="10"
        >
            <items>
                <ObjectListItem
                    id="descodificaUnidadeListItem"
                    title="{Material}"
                    intro="{MaterialDesc}"
                >
                    <attributes>
                        <ObjectAttribute
                            id="unEan"
                            title="Ean"
                            text="{Ean}"
                        />
                        <ObjectAttribute
                            id="unPrefixoEan"
                            title="Prefixo"
                            text="{PrefixoEan}"
                        />
                    </attributes>
                </ObjectListItem>
            </items>
        </List>
        <endButton>
            <Button
                id="descodificaUnidadeClose"
                text="{i18n>closeBtn}"
                press=".onPressUnCloseDialog"
            />
        </endButton>
    </Dialog>

</core:FragmentDefinition>