<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="unPesoDialog"
        title="{i18n>unPesoBalanca}"
        contentWidth="400px"
    >
        <form:SimpleForm
            id="unPesoForm"
            editable="true"
            labelSpanS="2"
        >
            <Button
                id="unPesoStart"
                text="{i18n>startBtn}"
                icon="sap-icon://begin"
                press=".onPressUnStart"
            />
            <Button
                id="unPesoEnd"
                text="{i18n>endBtn}"
                icon="sap-icon://media-pause"
                press=".onPressUnEnd"
                enabled="false"
            />
        </form:SimpleForm>

        <Table
            id="unPesoTable"
            growing="true"
            growingThreshold="10"
            mode="MultiSelect"
            items="{pesoUn>/PesosCollection}"
        >
            <headerToolbar>
                <OverflowToolbar id="unPesoToolbar">
                    <Title
                        id="unPesoTableTitle"
                        text="{i18n>unPesoBalanca}"
                    />
                    <ToolbarSpacer id="unPesoTableTS" />
                    <Button
                        id="unPesoDelete"
                        text="{i18n>deleteBtn}"
                        enabled="true"
                        press=".onPressDelete"
                    />
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column
                    id="unPesoTableColumnPeso"
                    demandPopin="true"
                    minScreenWidth="Phone"
                >
                    <Text
                        id="unPesoTableColumnPesoText"
                        text="{i18n>pesoBruto}"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    id="unPesoTableItems"
                    vAlign="Middle"
                >
                    <cells>
                        <Input
                            id="unPesoTablePb"
                            value="{pesoUn>PB}"
                            description="{pesoUn>Uom}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <beginButton>
            <Button
                id="unPesoOkay"
                text="{i18n>okayBtn}"
                icon="sap-icon://accept"
                press=".onPressOkayDialog"
            />
        </beginButton>
        <endButton>
            <Button
                id="unPesoClose"
                text="{i18n>closeBtn}"
                icon="sap-icon://decline"
                press=".onPressCloseDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
