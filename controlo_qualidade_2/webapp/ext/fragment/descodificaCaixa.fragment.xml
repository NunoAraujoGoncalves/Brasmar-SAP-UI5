<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="descodificaCBDialog"
        title="{i18n>descodificacbcaixa}"
        binding="{com.sap.gateway.srvd.zui_tabcq_o4.v0001.descodificaCBCaixa(...)}"
        contentWidth="400px"
    >
        <form:SimpleForm
            id="descodificaCBForm"
            binding="{$Parameter}"
            editable="true"
            labelSpanS="4"
        >
            <Label
                id="descodificaCBLabel"
                text="Código Barras"
            />
            <Input
                id="descodificaCBInput"
                value="{CodigoBarras}"
            />
            <Label
                id="empty"
                text=""
            />
            <Button
                id="descodifica"
                text="{i18n>descodificacbcaixa}"
                press=".onPressDescodifica"
            />
        </form:SimpleForm>
        <List
            id="descodificaCBList"
            items="{value}"
            busyIndicatorDelay="10"
        >
            <items>
                <ObjectListItem
                    id="descodificaCBListItem"
                    title="{Material}"
                    number="{Qtd}"
                    numberUnit="{Uom}"
                    intro="{MaterialDesc}"
                >
                    <attributes>
                        <ObjectAttribute
                            id="cxGtin"
                            title="Gtin"
                            text="{Gtin}"
                        />
                        <ObjectAttribute
                            id="cxLote"
                            title="Lote"
                            text="{Lote}"
                        />
                        <ObjectAttribute
                            id="cxValidade"
                            title="Validade"
                            text="{Validade}"
                        />
                        <ObjectAttribute
                            id="cxNEmbalCaixa"
                            title="Nº Unidades"
                            text="{NEmbalCaixa}"
                        />
                    </attributes>
                </ObjectListItem>
            </items>
        </List>
        <endButton>
            <Button
                id="descodificaCBClose"
                text="{i18n>closeBtn}"
                press=".onPressCloseDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
