<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="calibreDialog"
        title="{i18n>calibres}"
        contentWidth="400px"
    >
        <form:SimpleForm
            id="calibreForm"
            editable="true"
            labelSpanS="2"
        >
            <Button
                id="calibreStart"
                text="{i18n>startBtn}"
                icon="sap-icon://begin"
                press=".onPressCalibreStart"
            />
            <Button
                id="calibreEnd"
                text="{i18n>endBtn}"
                icon="sap-icon://media-pause"
                press=".onPressCalibreEnd"
                enabled="false"
            />
        </form:SimpleForm>

        <Table
            id="calibreTable"
            growing="true"
            growingThreshold="10"
            mode="MultiSelect"
            items="{pesoUn>/CalibresCollection}"
        >
            <headerToolbar>
                <OverflowToolbar id="calibreToolbar">
                    <Title
                        id="calibreTableTitle"
                        text="{i18n>calibres}"
                    />
                    <ToolbarSpacer id="calibreTableTS" />
                    <Button
                        id="calibreDelete"
                        text="{i18n>deleteBtn}"
                        enabled="true"
                        press=".onPressCalibreDelete"
                    />
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column
                    id="calibreTableColumnPeso"
                    demandPopin="true"
                    minScreenWidth="Phone"
                >
                    <Text
                        id="calibreTableColumnPesoText"
                        text="{i18n>medio}"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    id="calibreTableItems"
                    vAlign="Middle"
                >
                    <cells>
                        <Input
                            id="calibreTablePb"
                            value="{pesoUn>Medicao}"
                            description="{pesoUn>Uom}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <beginButton>
            <Button
                id="calibreOkay"
                text="{i18n>okayBtn}"
                icon="sap-icon://accept"
                press=".onPressCalibreOkayDialog"
            />
        </beginButton>
        <endButton>
            <Button
                id="calibreClose"
                text="{i18n>closeBtn}"
                icon="sap-icon://decline"
                press=".onPressCalibreCloseDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
